---
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/site.css';
import { localePath, type Lang } from '../i18n/content';
interface Props { title: string; description: string; path?: string; bodyClass?: string; lang?: Lang; image?: string; imageAlt?: string; type?: 'website' | 'article'; schema?: Record<string, unknown>[] }
const { title, description, path = '/', bodyClass, lang = 'en', image = `/og/home-${lang}.jpg`, imageAlt = title, type = 'website', schema = [] } = Astro.props;
const url = (l: Lang) => `https://rohitsuryaa.com${localePath(l, path)}`;
const abs = (p: string) => `https://rohitsuryaa.com${p}`;
---
<!doctype html>
<html lang={lang} class="no-js">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Rohit Suryaa Saravanan" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#0d0d0c" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="canonical" href={url(lang)} />
  <link rel="alternate" hreflang="en" href={url('en')} />
  <link rel="alternate" hreflang="de" href={url('de')} />
  <link rel="alternate" hreflang="x-default" href={url('en')} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Rohit Suryaa" />
  <meta property="og:image" content={abs(image)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:url" content={url(lang)} />
  <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
  <meta property="og:locale:alternate" content={lang === 'de' ? 'en_GB' : 'de_DE'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={abs(image)} />
  {schema.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schema })} />}
  <script is:inline>document.documentElement.classList.replace('no-js','js');try{if(localStorage.getItem('theme')==='light'){document.documentElement.dataset.theme='light';document.querySelector('meta[name=theme-color]').content='#f6f4ef'}}catch(e){}</script>
</head>
<body class={bodyClass}>
  <a class="skip" href="#main">{lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>
  <div class="cursor is-hidden" aria-hidden="true"><span class="cursor-label"></span></div>
  <slot />
</body>
</html>
