---
// A case study told as a scroll story: short steps on one side, one chart beside them that changes per step.
// Chart pieces carry data-show="stepA stepB": they appear while one of those steps is on screen.
// Helper classes (see site.css, "Scroll stories"): grow-x, grow-y, draw, pop, plus text styles t-*.
export interface Step { k: string; h: string; p: string; src?: { label: string; url: string }[] }
interface Props { steps: Step[]; label: string; sources: string }
const { steps, label, sources } = Astro.props;
---
<section class="story story-x" id="story" aria-label={label}>
  <figure class="story-fig" data-step={steps[0].k} aria-hidden="true">
    <svg viewBox="0 0 600 460" role="img">
      <defs><marker id="arrowhead" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="arrow-tip" /></marker></defs>
      <slot />
    </svg>
  </figure>
  <div class="story-steps">
    {steps.map((s, i) => (
      <article class="story-step" data-step={s.k}>
        <p class="mono story-k"><span>{String(i + 1).padStart(2, '0')}</span></p>
        <h2 class="story-h">{s.h}</h2>
        <p class="story-p">{s.p}</p>
        {s.src && (
          <p class="story-src mono">{sources}: {s.src.map((x, j) => <>{j > 0 && ' · '}<a href={x.url} target="_blank" rel="noopener">{x.label} ↗</a></>)}</p>
        )}
      </article>
    ))}
  </div>
</section>
