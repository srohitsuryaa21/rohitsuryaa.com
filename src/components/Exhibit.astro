---
interface Props {kind:string}
const {kind}=Astro.props;
const titles:Record<string,string>={wind:'KINETIC',supply:'SIGNAL',luxury:'DESIRE',finance:'TRUST',defi:'ROOTS',people:'HUMAN',aviation:'AIRSPACE',racing:'VELOCITY'};
---
<div class:list={['exhibit-art',`visual-${kind}`]} aria-hidden="true"><span class="art-word">{titles[kind]}</span><svg viewBox="0 0 800 560" fill="none">
{kind==='wind'?<g>{Array.from({length:36},(_,i)=><ellipse cx="400" cy="280" rx={60+i*4.4} ry="170" transform={`rotate(${i*5} 400 280)`} stroke="currentColor" stroke-width=".7" opacity={.3+i/70}/>)}</g>:kind==='supply'?<g>{Array.from({length:27},(_,i)=><path d={Array.from({length:81},(_,j)=>`${j?'L':'M'}${j*10} ${230+i*7+Math.sin(j*.11+i*.09)*Math.cos(j*.036)*85-Math.exp(-Math.pow((j-45)/14,2))*120}`).join(' ')} stroke="currentColor" stroke-width="1" opacity={.2+i/40}/>)}</g>:kind==='luxury'?<g>{Array.from({length:18},(_,i)=><path d={`M400 ${90+i*6} L${610-i*6} 280 L400 ${470-i*6} L${190+i*6} 280 Z`} stroke="currentColor" opacity={.2+i/25}/>)}<circle cx="400" cy="280" r="55" fill="currentColor" opacity=".12"/></g>:kind==='finance'?<g>{Array.from({length:13},(_,i)=><rect x={240+i*7} y={120+i*7} width={320-i*14} height={320-i*14} rx={30-i} transform={`rotate(${i*4-24} 400 280)`} stroke="currentColor" opacity={.25+i/18}/>)}<path d="M369 280L392 303L438 250" stroke="currentColor" stroke-width="4"/></g>:kind==='racing'?<g>{Array.from({length:17},(_,i)=><path d="M245 405L172 210Q165 180 204 159L298 105L348 144L465 117L526 190L604 220L555 291L460 295L410 398L328 429L291 358Z" transform={`translate(${i*2-17} ${i*-2+17})`} stroke="currentColor" opacity={.12+i/23}/>)}</g>:kind==='aviation'?<g>{Array.from({length:22},(_,i)=><path d={`M${100+i*9} 430 Q${200+i*12} ${-80+i*11} ${660-i*6} ${210+i*9}`} stroke="currentColor" opacity={.2+i/30}/>)}{[0,1,2,3,4].map(i=><circle cx={160+i*120} cy={380-Math.sin(i)*140} r="4" fill="currentColor"/>)}</g>:kind==='people'?<g>{Array.from({length:80},(_,i)=>{const a=i*2.399;const r=Math.sqrt(i)*20;return <circle cx={400+Math.cos(a)*r} cy={280+Math.sin(a)*r} r={i%7===0?11:4} stroke="currentColor" fill={i%7===0?'none':'currentColor'} opacity={.25+(i%5)*.15}/>})}</g>:<g>{Array.from({length:28},(_,i)=><path d={`M400 470 Q${120+i*20} 260 ${150+i*19} 110`} stroke="currentColor" opacity={.2+i/40}/>)}<circle cx="400" cy="280" r="125" stroke="currentColor" stroke-dasharray="2 8"/></g>}
</svg><span class="art-axis axis-x"></span><span class="art-axis axis-y"></span></div>
