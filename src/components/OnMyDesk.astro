---
// "On my desk": the next project, planned. Anschluss: the chance of making a train connection in Germany,
// from Deutsche Bahn's open timetable and delay data (CC BY 4.0). Nothing here claims results yet.
import type { Lang } from '../i18n/content';
interface Props { lang: Lang }
const de = Astro.props.lang === 'de';
const n = (en: string, d: string) => (de ? d : en);
const plan = de ? [
    ['01', 'Sammeln', 'Monatliche DB Verspätungsdaten für jeden Bahnhof, ab 2024.'],
    ['02', 'Lernen', 'Verspätung als Bandbreite von Ergebnissen, nicht als eine Schätzung.'],
    ['03', 'Verbinden', 'P(Anschluss) = Chance, dass die Verspätung in die Umstiegszeit passt.'],
    ['04', 'Beraten', 'Ein Agent vergleicht Routen und wählt die, die am ehesten klappt.'],
  ] : [
    ['01', 'Collect', 'Monthly DB delay files for every station, from 2024 on.'],
    ['02', 'Learn', 'Arrival delay as a range of outcomes, not one guess.'],
    ['03', 'Connect', 'P(make it) = chance the delay fits inside the transfer time.'],
    ['04', 'Advise', 'An agent compares routes and picks the one most likely to work.'],
  ];
const src = 'https://eisenbahn.de/geramond-vgb/jahresbilanz-2025-puenktlichkeit-der-deutschen-bahn-sinkt-weiter_17653';
// a bell shaped arrival curve for the incoming train; the connection leaves at the dashed line
const W = 640, base = 300, x0 = 60, peak = 250, spread = 70, depart = 360;
const pts = Array.from({ length: 81 }, (_, i) => {
  const x = x0 + i * 7;
  const y = base - 170 * Math.exp(-((x - peak) ** 2) / (2 * spread ** 2));
  return [x, y] as const;
});
const curve = 'M' + pts.map(([x, y]) => `${x} ${y.toFixed(1)}`).join(' L');
const late = pts.filter(([x]) => x >= depart);
const lateArea = `M${depart} ${base} L` + late.map(([x, y]) => `${x} ${y.toFixed(1)}`).join(' L') + ` L${late[late.length - 1][0]} ${base} Z`;
---
<section class="desk" aria-labelledby="desk-title">
  <div class="section-label mono"><span>(03)</span><span>{n('Next stop', 'Nächster Halt')}</span><span>{n('Boarding soon', 'Einstieg bald')}</span></div>
  <div class="desk-grid">
    <div class="desk-copy">
      <h2 id="desk-title">{n('Will I make my connection?', 'Erwische ich meinen Anschluss?')} <em>Anschluss.</em></h2>
      <ul class="desk-points">
        <li><b>{n('Why', 'Warum')}</b><span>{n('Only 60.1% of Deutsche Bahn long-distance trains were on time in 2025.', 'Nur 60,1 % der Fernzüge der Deutschen Bahn waren 2025 pünktlich.')} <a href={src} target="_blank" rel="noopener">↗</a></span></li>
        <li><b>{n('The data', 'Die Daten')}</b><span>{n('DB’s open timetable and delay data for every station.', 'Offene Fahrplan und Verspätungsdaten der DB für jeden Bahnhof.')}</span></li>
        <li><b>{n('The model', 'Das Modell')}</b><span>{n('The chance of making a transfer, with honest uncertainty.', 'Die Chance auf den Umstieg, mit ehrlicher Unsicherheit.')}</span></li>
        <li><b>{n('The twist', 'Der Dreh')}</b><span>{n('An agent that picks the safest connection, not the fastest.', 'Ein Agent, der den sichersten Anschluss wählt, nicht den schnellsten.')}</span></li>
      </ul>
      <p class="desk-status mono"><i class="pulse"></i> {n('Starting from Fulda, an ICE hub', 'Start in Fulda, einem ICE Knoten')}</p>
    </div>
    <svg class="desk-map" viewBox={`0 0 ${W} 400`} role="img" aria-label={n('An incoming train’s possible arrival times against the departure of the connecting train', 'Mögliche Ankunftszeiten des Zubringers gegen die Abfahrt des Anschlusses')}>
      <line x1={x0} x2={W - 20} y1={base} y2={base} class="desk-axis" />
      <path d={lateArea} class="desk-late" />
      <path d={curve} class="desk-curve" />
      <line x1={depart} x2={depart} y1="70" y2={base} class="desk-depart" />
      <text x={peak} y="110" text-anchor="middle" class="desk-t">{n('ICE arrives', 'ICE kommt an')}</text>
      <text x={depart + 10} y="88" class="desk-t desk-hl">{n('Connection leaves', 'Anschluss fährt')}</text>
      <text x={depart + 80} y="270" text-anchor="middle" class="desk-t desk-hl">{n('missed', 'verpasst')}</text>
      <text x={x0} y={base + 34} class="desk-c">{n('arrival time →', 'Ankunftszeit →')}</text>
      <text x={W / 2} y="372" text-anchor="middle" class="desk-big">P({n('make it', 'Anschluss')}) = ?</text>
    </svg>
  </div>
  <!-- the deeper plan: opens on hover (mouse) or with the button (touch) -->
  <button class="desk-toggle mono" type="button" aria-expanded="false" aria-controls="desk-more">{n('The plan', 'Der Plan')} <span aria-hidden="true">+</span></button>
  <div class="desk-more" id="desk-more"><div class="desk-more-in">
    <ol class="desk-plan">
      {plan.map(([k, h, p]) => <li><span class="mono">{k}</span><b>{h}</b><p>{p}</p></li>)}
    </ol>
    <div class="desk-meta">
      <p><span class="mono">{n('Stack', 'Stack')}</span>Python · DuckDB · LightGBM · {n('conformal prediction', 'Conformal Prediction')} · FastAPI · LangGraph</p>
      <p><span class="mono">{n('Done when', 'Fertig, wenn')}</span>{n('Of the transfers it calls 80% likely, about 80% are actually made.', 'Von den Umstiegen, die es mit 80 % ansagt, klappen auch etwa 80 %.')}</p>
    </div>
  </div></div>
</section>

<script>
  const desk = document.querySelector<HTMLElement>('.desk');
  const btn = desk?.querySelector<HTMLButtonElement>('.desk-toggle');
  btn?.addEventListener('click', () => {
    const open = !desk!.classList.contains('is-open');
    desk!.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
