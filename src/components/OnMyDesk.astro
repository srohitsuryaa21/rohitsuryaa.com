---
// "On my desk": work in progress. Facts from the integration plan in the (private) laser-correction-prediction-system
// repository: table sizes and join match rates as measured there. No company or teammate names.
import type { Lang } from '../i18n/content';
interface Props { lang: Lang }
const de = Astro.props.lang === 'de';
const n = (en: string, d: string) => (de ? d : en);
// one node per production table; links are the measured join match rates
const nodes = [
  { id: 'order', x: 110, y: 120, t: n('Production order', 'Fertigungsauftrag'), c: n('3,121 orders', '3.121 Aufträge'), main: true },
  { id: 'print', x: 110, y: 330, t: n('Screen printing', 'Siebdruck'), c: n('by order', 'je Auftrag') },
  { id: 'quality', x: 360, y: 40, t: n('Quality output', 'Qualität'), c: n('label side', 'Zielseite') },
  { id: 'sub', x: 400, y: 230, t: 'Substrat', c: n('47,115 substrates', '47.115 Substrate'), main: true },
  { id: 'sputter', x: 650, y: 140, t: n('Sputtering', 'Sputtern'), c: n('by substrate', 'je Substrat') },
  { id: 'laser', x: 650, y: 330, t: 'Laser', c: n('NC target', 'NC Ziel') },
];
const at = (id: string) => nodes.find((x) => x.id === id)!;
const links = [
  { a: 'order', b: 'print', v: 100 },
  { a: 'order', b: 'quality', v: 57.8 },
  { a: 'order', b: 'sub', v: 32.3, warn: true },
  { a: 'sub', b: 'sputter', v: 99.4 },
  { a: 'sub', b: 'laser', v: 78.8 },
];
const fmt = (v: number) => (de ? `${String(v).replace('.', ',')} %` : `${v}%`);
---
<section class="desk" aria-labelledby="desk-title">
  <div class="section-label mono"><span>(05)</span><span>{n('On my desk', 'Auf meinem Tisch')}</span><span>{n('Work in progress', 'In Arbeit')}</span></div>
  <div class="desk-grid">
    <div class="desk-copy">
      <h2 id="desk-title">{n('Seven production tables.', 'Sieben Fertigungstabellen.')} <em>{n('One dataset.', 'Ein Datensatz.')}</em></h2>
      <ul class="desk-points">
        <li><b>{n('The goal', 'Das Ziel')}</b>{n('Predict laser correction for sensor production.', 'Die Laserkorrektur in der Sensorfertigung vorhersagen.')}</li>
        <li><b>{n('My part', 'Mein Teil')}</b>{n('Designing how every table joins. MSc team project.', 'Festlegen, wie alle Tabellen zusammenhängen. Teamprojekt im Master.')}</li>
        <li><b>{n('The rule', 'Die Regel')}</b>{n('Join on IDs, never on timestamps.', 'Über IDs verknüpfen, nie über Zeitstempel.')}</li>
        <li><b>{n('The catch', 'Der Haken')}</b>{n('Only 1,007 of 3,121 orders reach a substrate.', 'Nur 1.007 von 3.121 Aufträgen erreichen ein Substrat.')}</li>
      </ul>
      <p class="desk-status mono"><i class="pulse"></i> {n('Next: the laser target, then the first model', 'Als Nächstes: das Laserziel, dann das erste Modell')}</p>
    </div>
    <svg class="desk-map" viewBox="0 0 780 420" role="img" aria-label={n('How the seven production tables join, with match rates', 'Wie die Fertigungstabellen zusammenhängen, mit Trefferquoten')}>
      {links.map((l, i) => {
        const a = at(l.a), b = at(l.b);
        return (
          <g class={l.warn ? 'link warn' : 'link'} style={`--i:${i}`}>
            <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} pathLength="1" />
            <text x={(a.x + b.x) / 2} y={(a.y + b.y) / 2 - 10} text-anchor="middle">{fmt(l.v)}</text>
          </g>
        );
      })}
      {nodes.map((d, i) => (
        <g class={d.main ? 'node main' : 'node'} style={`--i:${i}`}>
          <rect x={d.x - 85} y={d.y - 30} width="170" height="60" rx="14" />
          <text x={d.x} y={d.y - 2} text-anchor="middle" class="nt">{d.t}</text>
          <text x={d.x} y={d.y + 18} text-anchor="middle" class="nc">{d.c}</text>
        </g>
      ))}
    </svg>
  </div>
</section>
